# --- HTTP server ---
# Bind to loopback only. Never expose the adapter to the LAN.
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765
# Optional local API secret. If set, requests must carry
# Authorization: Bearer <ADAPTER_API_KEY>. This is a local-only secret,
# not a ChatGPT credential.
ADAPTER_API_KEY=

# --- Chrome / CDP ---
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CDP endpoint. localhost only. 9233 (9232/9223 may be used by other tools).
CHROME_CDP_HOST=127.0.0.1
CHROME_CDP_PORT=9233
# Dedicated profile. Log into ChatGPT manually in this profile once.
CHROME_PROFILE_DIR=C:\Hermes\chatgpt-web-profile
# If true and no Chrome is already listening on the CDP port, the adapter
# launches Chrome itself with the dedicated profile.
CHROME_LAUNCH_AT_STARTUP=true

# --- Behavior ---
# Total time to wait for a response before failing with GENERATION_TIMEOUT.
ADAPTER_TIMEOUT_MS=180000
# How long the response text must remain unchanged before it counts as stable.
RESPONSE_STABLE_MS=2000
LOG_LEVEL=info
